{
  "name": "dragon-master-zero",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite",
    "build": "tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.server.json && vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/server.mjs",
    "start": "node dist-server/server.mjs",
    "test": "vitest run",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "express": "^5.1.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
